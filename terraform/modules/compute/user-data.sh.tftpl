#!/bin/bash
# api bundle md5: ${api_bundle_md5}
set -euxo pipefail
dnf install -y nodejs
install -d /opt/snowball
aws s3 cp "s3://${artifact_bucket}/api.bundle.js" /opt/snowball/api.bundle.js
cat >/etc/snowball.env <<'ENV'
AWS_REGION=${region}
JWT_SECRET=${jwt_secret}
CORS_ORIGIN=${cors_origin}
IOT_ENDPOINT=${iot_endpoint}
DDB_TABLE=${telemetry_table}
DDB_STATE_TABLE=${state_table}
DDB_USERS_TABLE=${users_table}
DDB_CLIENTS_TABLE=${clients_table}
DDB_UNITS_TABLE=${units_table}
DDB_ALERTS_TABLE=${alerts_table}
DDB_DEVICE_CONFIG_TABLE=${config_table}
PORT=3000
ENV
chmod 600 /etc/snowball.env
cat >/etc/systemd/system/snowball-api.service <<'UNIT'
[Unit]
Description=Snowball api
After=network-online.target
Wants=network-online.target
[Service]
EnvironmentFile=/etc/snowball.env
ExecStart=/usr/bin/node /opt/snowball/api.bundle.js
Restart=always
RestartSec=5
User=ec2-user
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now snowball-api
