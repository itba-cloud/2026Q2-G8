{
  "name": "@snowball/telemetry-export",
  "version": "0.1.0",
  "private": true,
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --outfile=dist/index.js",
    "zip": "cd dist && (zip -j telemetry-export.zip index.js || python -m zipfile -c telemetry-export.zip index.js)"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@snowball/shared": "*"
  }
}
