# Required
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Needed for PUT /api/units/:id/config (setpoint) and GET /api/units/:id/shadow.
# Same -ats endpoint the simulator uses. Unset → those calls answer 503.
IOT_ENDPOINT=
# Origin allowed by CORS. "*" only for local dev; on EC2 use the S3 website URL.
CORS_ORIGIN=*
# Optional
PORT=3000
LIVE_POLL_MS=3000
DDB_TABLE=snowball-telemetry
AWS_REGION=us-east-1
