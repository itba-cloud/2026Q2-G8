{
  "name": "@snowball/alert-processor",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --outfile=dist/lambda/index.js",
    "zip": "cd dist/lambda && (zip -j ../alert-processor.zip index.js || python -m zipfile -c ../alert-processor.zip index.js)",
    "bundle:no-signal": "esbuild src/no-signal-handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --outfile=dist/no-signal/index.js",
    "zip:no-signal": "cd dist/no-signal && (zip -j ../no-signal-monitor.zip index.js || python -m zipfile -c ../no-signal-monitor.zip index.js)"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@snowball/shared": "*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164"
  }
}
